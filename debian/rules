#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:
	python3 -m unittest discover -s tests

override_dh_auto_install:
	install -d debian/oss/usr/lib/oss
	cp -r src/ossgui debian/oss/usr/lib/oss/
	find debian/oss -name '__pycache__' -type d -exec rm -rf {} +
	install -D -m 0755 oss debian/oss/usr/bin/oss
	install -D -m 0755 helper/oss-helper \
	        debian/oss/usr/libexec/oss-helper
	install -D -m 0644 data/polkit/io.github.jegly.OSS.policy \
	        debian/oss/usr/share/polkit-1/actions/io.github.jegly.OSS.policy
	install -D -m 0644 data/desktop/oss.desktop \
	        debian/oss/usr/share/applications/oss.desktop
	install -d debian/oss/usr/share/oss
	cp -r data/catalogue data/presets data/themes \
	        debian/oss/usr/share/oss/
